# Run scripts/generate-env.sh to generate real secrets. Do not commit .env.

# Core
PORT=4000
POSTGRES_PASSWORD=generate-random-hex
CRM_APP_PASSWORD=generate-random-hex
JWT_SECRET=generate-48-random-bytes
FIELD_ENCRYPTION_KEY=generate-32-random-bytes-as-64-hex-characters
CONTACT_HASH_KEY=generate-48-random-bytes

# CORS / cookies
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SITE_ADDRESS=localhost

# For API development outside Docker, add a connection to your local PostgreSQL:
# DATABASE_URL=postgresql://crm_app:YOUR_APP_PASSWORD@127.0.0.1:5432/crm

# For AWS RDS (requires SSL):
# DATABASE_URL=postgresql://crm_app:YOUR_APP_PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/crm?sslmode=require
# DATABASE_SSL=true

# For public HTTPS deployment:
# SITE_ADDRESS=crm.example.com
# CORS_ORIGIN=https://crm.example.com
# COOKIE_SECURE=true
# APP_BASE_URL=https://crm.example.com

# Email — AWS SES (recommended for production)
# SES_REGION=ap-south-1
# SES_FROM_EMAIL=no-reply@crm.example.com

# Email — SMTP fallback (local dev / alternative providers)
# SMTP_URL=smtp://user:pass@smtp.example.com:587

# Public URL used in email links
# APP_BASE_URL=http://localhost:3000

# Google SSO (optional — set up at console.cloud.google.com)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
